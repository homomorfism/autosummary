# Copy to .env and fill in for yourself: cp .env.example .env

# --- which STT provider to use by default ---
# whisper_cpp (local, free, private) or google_stt (cloud)
STT_PROVIDER=whisper_cpp

# --- whisper.cpp (local STT) ---
# IMPORTANT: use the build WITHOUT Core ML. The .../build/ build on this machine
# was built with Core ML and crashes without an .mlmodelc encoder. build-nocoreml is the working one.
WHISPER_CLI=/Users/shamilarslanov/whisper.cpp/build-nocoreml/bin/whisper-cli
WHISPER_MODEL=/Users/shamilarslanov/whisper-models/ggml-large-v3-turbo.bin
WHISPER_VAD_MODEL=/Users/shamilarslanov/whisper-models/ggml-silero-v6.2.0.bin
WHISPER_LANGUAGE=en

# --- Google Cloud Speech-to-Text (cloud STT) ---
# Service-account authentication (the SDK reads this variable itself):
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-credentials.json
GCP_PROJECT_ID=summarize-it-499119
# GCS bucket for temporary audio upload (long_running_recognize reads from GCS):
GCS_STT_BUCKET=summarize-it-499119-stt-local
GOOGLE_STT_LANGUAGE=en-US
GOOGLE_STT_MODEL=latest_long

# --- LLM (summarization and judge) ---
# Provider: anthropic | deepseek. If empty, inferred from the model name
# (claude-* → anthropic, deepseek-* → deepseek), otherwise deepseek.
LLM_PROVIDER=
LLM_MODEL=deepseek-v4-pro

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
