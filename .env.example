# Скопируйте в .env и заполните под себя: cp .env.example .env

# --- какой STT-провайдер использовать по умолчанию ---
# whisper_cpp (локально, бесплатно, приватно) или google_stt (облако)
STT_PROVIDER=whisper_cpp

# --- whisper.cpp (локальный STT) ---
# ВАЖНО: используйте сборку БЕЗ Core ML. Сборка .../build/ на этой машине
# собрана с Core ML и падает без .mlmodelc-энкодера. build-nocoreml — рабочая.
WHISPER_CLI=/Users/shamilarslanov/whisper.cpp/build-nocoreml/bin/whisper-cli
WHISPER_MODEL=/Users/shamilarslanov/whisper-models/ggml-large-v3-turbo.bin
WHISPER_VAD_MODEL=/Users/shamilarslanov/whisper-models/ggml-silero-v6.2.0.bin
WHISPER_LANGUAGE=en

# --- Google Cloud Speech-to-Text (облачный STT) ---
# Аутентификация сервис-аккаунтом (SDK сам читает эту переменную):
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-credentials.json
GCP_PROJECT_ID=summarize-it-499119
# Бакет GCS для временной загрузки аудио (long_running_recognize читает из GCS):
GCS_STT_BUCKET=summarize-it-499119-stt-local
GOOGLE_STT_LANGUAGE=en-US
GOOGLE_STT_MODEL=latest_long

# --- LLM (суммаризация и судья) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
